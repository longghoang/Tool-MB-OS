  <style>
    :root{color-scheme:dark;--bg:#08090d;--surface:#111319;--surface2:#171a22;--line:#262b36;--muted:#8992a4;--text:#eef2f8;--blue:#6472ff;--cyan:#00d9c0;--green:#22d59b;--red:#ff6574;--amber:#f4b740;--shadow:0 20px 70px #0008}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 25% -10%,#24264a 0,#0d0f18 31%,var(--bg) 68%);color:var(--text);font:14px/1.55 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(#fff00006 1px,transparent 1px),linear-gradient(90deg,#fff00006 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(to bottom,#0008,transparent 65%)}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit;color:inherit}button{cursor:pointer}
    .app{position:relative;z-index:1;max-width:1480px;margin:auto;padding:18px 22px 42px}.topbar{height:68px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #ffffff0d;margin-bottom:22px}.brand{display:flex;align-items:center;gap:11px;margin-right:auto}.brand-mark{width:40px;height:40px;display:grid;place-items:center;border:1px solid #ffffff18;border-radius:12px;background:linear-gradient(135deg,#252946,#11131b);box-shadow:0 8px 30px #0008;font-size:18px}.brand strong{display:block;letter-spacing:.02em}.brand small{color:var(--muted);font-size:11px}.top-pill{height:42px;display:flex;align-items:center;gap:8px;padding:0 16px;border:1px solid var(--line);border-radius:12px;background:#12151d;color:#bac2d1;font-weight:650}.top-pill.blue{border-color:#5865e8;background:#171936;color:#8e98ff}.top-pill.green{border-color:#0b725f;background:#092a29;color:#42e5c7}.top-pill.amber{border-color:#946d16;color:#ffd15a}.top-pill .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green)}
    .hero{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:28px 0 20px}.eyebrow{color:#7e89ff;font-weight:750;letter-spacing:.12em;text-transform:uppercase;font-size:11px}.hero h1{font-size:34px;line-height:1.1;margin:8px 0 7px;letter-spacing:-.04em}.hero p{margin:0;color:var(--muted);max-width:700px}.hero-meta{text-align:right;color:var(--muted);font-size:12px}.hero-meta strong{display:block;color:var(--text);font-size:18px}
    .workflow-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:0 0 18px}.workflow-step{display:grid;grid-template-columns:32px 1fr;column-gap:10px;row-gap:3px;text-align:left;align-items:center;padding:13px 15px;border:1px solid #2b3040;border-radius:13px;background:#11141c;color:var(--text);transition:background .18s,border-color .18s,transform .18s}.workflow-step:hover{border-color:#5865e8;transform:translateY(-1px)}.workflow-step.active{border-color:#5966f2;background:linear-gradient(130deg,#1b2040,#121722);box-shadow:0 8px 24px #515dff20}.workflow-step>span{grid-row:span 2;width:30px;height:30px;display:grid;place-items:center;border-radius:9px;background:#202541;color:#8994ff;font-size:11px;font-weight:800}.workflow-step strong{font-size:13px}.workflow-step small{font-size:11px;color:var(--muted)}.workflow-panel{animation:panel-in .2s ease-out}@keyframes panel-in{from{opacity:.7;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}.card{background:linear-gradient(145deg,#141720,#0e1016);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)}.intake{padding:22px;margin-bottom:18px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:17px}.section-head h2{font-size:16px;margin:0}.section-head span{color:var(--muted);font-size:12px}.input-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:14px}.input-grid.references-hidden{grid-template-columns:1fr}.dropzone,.field{border:1px solid #303644;border-radius:14px;background:#0d1017;padding:18px}.dropzone{min-height:137px;display:flex;align-items:center;gap:14px;border-style:dashed}.drop-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:#1a2140;color:#8d97ff;font-size:21px}.dropzone strong{display:block;margin-bottom:4px}.muted{color:var(--muted)}label{display:block;color:#cbd2df;font-size:12px;font-weight:700;margin-bottom:8px}textarea,input{width:100%;border:1px solid #303644;border-radius:10px;background:#0b0e14;padding:11px 12px;outline:none;transition:.2s}textarea:focus,input:focus{border-color:#6571ff;box-shadow:0 0 0 3px #5964ff22}textarea{resize:vertical}.field small{display:block;color:#6f7889;margin-top:8px}.actions{display:flex;align-items:center;gap:10px;margin-top:17px}.btn{border:1px solid #3a4358;border-radius:10px;background:#1a2030;padding:10px 15px;font-weight:750}.btn.primary{border-color:#6974ff;background:linear-gradient(135deg,#5663f5,#3e4bd2);box-shadow:0 8px 25px #5363ff33}.btn.ghost{background:transparent;color:#b9c2d1}.btn:disabled{opacity:.5;cursor:wait}
    .status-line{display:flex;align-items:center;gap:10px;margin-top:14px;color:#b4bdcc;min-height:20px}.error{color:#ff8995}.progress-wrap{margin-top:13px}.progress-track{height:9px;overflow:hidden;border-radius:99px;background:#242a38}.progress-bar{height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--cyan));transition:width .3s ease}.progress-label{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;margin-top:6px}
    .workspace{margin-top:18px}.workspace-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:15px}.workspace-tools .spacer{flex:1}.result-layout{display:grid;grid-template-columns:minmax(0,1fr) 390px;gap:18px;align-items:start}.result{padding:24px;min-width:0}.result h2{font-size:17px;margin:23px 0 10px}.result h2:first-child{margin-top:0}.result h3{font-size:13px;color:#c6cede;margin:18px 0 5px}.result p{margin:7px 0}.result-summary{font-size:16px;color:#dce2ee}.prose{white-space:pre-wrap;overflow-wrap:anywhere}.subcard{border:1px solid #29303d;border-radius:13px;background:#0e1118;padding:14px;margin:10px 0}.finding{border-left:3px solid var(--amber);background:#211c12;border-radius:9px;padding:13px 15px;margin:10px 0}.finding h3{color:#ffd36b;margin:0 0 5px}.table-wrap{overflow:auto;border:1px solid #29303d;border-radius:12px}.result table{border-collapse:collapse;width:100%;font-size:13px}.result th,.result td{padding:10px;border-bottom:1px solid #29303d;text-align:left;vertical-align:top;overflow-wrap:anywhere}.result th{background:#171b25;color:#aeb8ca;font-size:11px;text-transform:uppercase;letter-spacing:.05em}.result tr:last-child td{border-bottom:0}.result details{margin-top:14px}.result summary{cursor:pointer;color:#8e99ff}.check-alert,.check-review,.check-pass,.check-na{padding:13px 15px;margin:10px 0;border-radius:10px}.check-alert{border:1px solid #9f3848;border-left:4px solid var(--red);background:#2a151b}.check-review{border:1px solid #966d22;border-left:4px solid var(--amber);background:#2a2111}.check-pass{border:1px solid #1d815f;border-left:4px solid var(--green);background:#10251f}.check-na{border:1px solid #3b4554;border-left:4px solid #778397;background:#171c25}.check-alert h3,.check-review h3,.check-pass h3,.check-na h3{margin:0 0 4px;font-size:13px}.check-alert h3{color:#ff8591}.check-review h3{color:#ffd168}.check-pass h3{color:#4fe2b1}.check-na h3{color:#aab4c4}
    .chat-panel{position:sticky;top:16px;height:calc(100vh - 110px);min-height:560px;display:flex;flex-direction:column;overflow:hidden;padding:0;background:#0b0d12;border-color:#292d38}.chat-head{display:flex;align-items:center;gap:11px;padding:17px 18px;border-bottom:1px solid #ffffff0e;background:#11141b}.bot-avatar{width:34px;height:34px;display:grid;place-items:center;border-radius:50%;border:1px solid #007f76;background:#062e2e;color:#31ead0;box-shadow:0 0 18px #00d9c033}.chat-head strong{display:block}.chat-head small{color:#728092}.chat-online{margin-left:auto;display:flex;align-items:center;gap:6px;color:#36d8b3;font-size:11px}.chat-online i{width:6px;height:6px;border-radius:50%;background:#36d8b3;box-shadow:0 0 10px #36d8b3}.chat-history{flex:1;overflow:auto;padding:22px 16px 14px;display:flex;flex-direction:column;gap:15px}.chat-row{display:flex;gap:8px;align-items:flex-end}.chat-row.user{justify-content:flex-end}.chat-bubble{max-width:86%;padding:11px 13px;border-radius:15px;white-space:pre-wrap;overflow-wrap:anywhere;box-shadow:0 6px 20px #0003}.chat-user{border-bottom-right-radius:5px;background:#252831;color:#eef1f7}.chat-assistant{border-bottom-left-radius:5px;background:#151a24;color:#dce3ee;border:1px solid #252c39}.chat-mini-avatar{width:24px;height:24px;flex:0 0 24px;display:grid;place-items:center;border-radius:50%;font-size:12px;background:#063a37;color:#2ce4c8;border:1px solid #087a6c}.chat-empty{margin:auto;text-align:center;color:#748093;max-width:260px}.typing{display:flex;gap:4px;align-items:center;padding:13px 15px}.typing i{display:block;width:6px;height:6px;border-radius:50%;background:#6974ff;animation:bounce 1.1s infinite}.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}@keyframes bounce{0%,60%,100%{transform:translateY(0);opacity:.45}30%{transform:translateY(-4px);opacity:1}}.chat-compose{padding:12px;border-top:1px solid #ffffff0e;background:#0e1117}.chat-form{position:relative}.chat-form textarea{min-height:58px;max-height:130px;padding:12px 50px 12px 13px;border-radius:15px;background:#17191f;border-color:#2a2e38}.chat-form button{position:absolute;right:8px;bottom:8px;width:34px;height:34px;padding:0;border:0;border-radius:50%;background:#3b404d;color:#d8deeb;font-size:17px}.chat-form button:hover{background:#5963ff}.chat-error{font-size:12px;margin:6px 2px 0}.chat-hint{font-size:11px;color:#687487;margin:7px 2px 0}
    [hidden]{display:none!important}@media(max-width:1080px){.result-layout{grid-template-columns:1fr}.chat-panel{position:relative;top:auto;height:620px}}@media(max-width:720px){.workflow-nav{grid-template-columns:1fr}.app{padding:12px}.topbar{overflow:auto}.top-pill{white-space:nowrap}.hero{display:block}.hero-meta{text-align:left;margin-top:15px}.input-grid{grid-template-columns:1fr}.result{padding:17px}.workspace-tools .spacer{display:none}}
    @media print{.topbar,.hero,.intake,.workspace-tools,.chat-panel,.progress-wrap{display:none!important}.app{max-width:none;padding:0}.result-layout{display:block}.card,.result{background:#fff;color:#111;box-shadow:none;border:0}.result th,.result td{border-color:#ccc}}
  </style>
  <style>
    html{scroll-behavior:smooth}
    body{background:radial-gradient(ellipse 90% 55% at 50% -18%,#30376d55 0%,transparent 62%),radial-gradient(circle at 14% 34%,#00d9c012 0%,transparent 26%),radial-gradient(circle at 92% 76%,#6974ff14 0%,transparent 30%),var(--bg);overflow-x:hidden}
