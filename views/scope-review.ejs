    .top-pill .dot{animation:online-pulse 2.4s ease-in-out infinite}
    .workflow-nav{gap:14px}.workflow-step{position:relative;overflow:hidden;min-height:72px;border-color:#343b4d;background:linear-gradient(145deg,#151a26,#10141d);box-shadow:inset 0 1px #ffffff09;transition:transform .24s cubic-bezier(.2,.7,.2,1),border-color .24s ease,box-shadow .24s ease,background .24s ease}.workflow-step:before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 28%,#ffffff08 48%,transparent 67%);transform:translateX(-130%);transition:transform .55s ease}.workflow-step:hover:before{transform:translateX(130%)}.workflow-step:hover{border-color:#7885ffb5;transform:translateY(-3px);box-shadow:0 12px 28px #0005,inset 0 1px #ffffff12}.workflow-step.active{border-color:#7080ff;background:linear-gradient(125deg,#202752,#121a2a);box-shadow:0 12px 34px #3c4eff2e,inset 0 1px #ffffff20}.workflow-step>span{background:linear-gradient(145deg,#303a72,#20274c);color:#b8c0ff;box-shadow:inset 0 1px #ffffff1a}
    .card{border-color:#303747;background:linear-gradient(145deg,#151a25ed,#0d1119ed);box-shadow:0 22px 66px #0006,inset 0 1px #ffffff08}.intake,.result,.chat-panel{transition:border-color .25s ease,box-shadow .25s ease}.intake:hover{border-color:#46506a;box-shadow:0 24px 72px #0007,inset 0 1px #ffffff0b}
    .dropzone,.field{border-color:#3a4354;background:linear-gradient(145deg,#101620,#0b0f17);transition:border-color .22s ease,background .22s ease,transform .22s ease}.dropzone:hover{border-color:#6f7df7;border-style:solid;background:#11182a;transform:translateY(-1px)}.drop-icon{background:linear-gradient(145deg,#2d3975,#18204b);box-shadow:0 10px 24px #344eff2d}
    textarea,input{border-color:#394355;background:#0a0f18;transition:border-color .2s ease,box-shadow .2s ease,background .2s ease,transform .2s ease}textarea:hover,input:hover{border-color:#56627a}textarea:focus,input:focus{background:#0d1320;transform:translateY(-1px);box-shadow:0 0 0 3px #5964ff20,0 8px 24px #0004}
    .btn{position:relative;overflow:hidden;isolation:isolate;transition:transform .2s cubic-bezier(.2,.7,.2,1),box-shadow .2s ease,border-color .2s ease,background .2s ease}.btn:not(:disabled):hover{transform:translateY(-2px);border-color:#7885ff;box-shadow:0 10px 24px #0005}.btn.primary:after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(105deg,transparent 24%,#ffffff30 48%,transparent 70%);transform:translateX(-125%);transition:transform .55s ease}.btn.primary:not(:disabled):hover:after{transform:translateX(125%)}.btn.primary{box-shadow:0 10px 28px #5363ff3d}
    .progress-track{background:#222a3b;box-shadow:inset 0 1px 3px #0009}.progress-bar{position:relative;overflow:hidden;box-shadow:0 0 16px #34d8cf66}.progress-bar:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,#ffffff72,transparent);animation:progress-sheen 1.8s linear infinite}
    .chat-panel{border-color:#354052;background:linear-gradient(160deg,#0e1420,#090c13)}.chat-head{background:linear-gradient(105deg,#161d2c,#10151f)}.bot-avatar{background:radial-gradient(circle at 35% 30%,#155e61,#063334);box-shadow:0 0 22px #00d9c044}.chat-bubble{transition:transform .2s ease,box-shadow .2s ease}.chat-bubble:hover{transform:translateY(-1px);box-shadow:0 10px 24px #0005}.chat-compose{background:#0c111a}
    ::selection{background:#7180ff70;color:#fff}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{border:3px solid #0d1119;border-radius:999px;background:#414c64}::-webkit-scrollbar-thumb:hover{background:#6674a0}
    @keyframes app-arrive{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}@keyframes ambient-drift{from{transform:translate3d(-1.5%,-1%,0) scale(1)}to{transform:translate3d(2%,1.5%,0) scale(1.05)}}@keyframes brand-sheen{to{transform:rotate(360deg)}}@keyframes online-pulse{0%,100%{box-shadow:0 0 8px var(--green)}50%{box-shadow:0 0 17px 4px #22d59b55}}@keyframes progress-sheen{from{transform:translateX(-110%)}to{transform:translateX(110%)}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
    @media(max-width:720px){.topbar{padding:8px;gap:8px;border-radius:14px}.brand-mark{width:42px;height:42px}.top-pill{height:40px;padding:0 12px}}
