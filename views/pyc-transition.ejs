<!DOCTYPE html>
<html>
<head>
  <title>PYC Transition</title>
  <style>
    body {
      background: #111;
      color: #fff;
      font-family: Arial;
      padding: 40px;
      text-align: center;
    }
    textarea {
      width: 400px;
      height: 100px;
      border-radius: 6px;
      padding: 10px;
    }
    button {
      margin-top: 20px;
      padding: 12px 30px;
      font-size: 16px;
      background: #1f6feb;
      border: none;
      border-radius: 6px;
      color: #fff;
      cursor: pointer;
    }
    pre {
      text-align: left;
      margin: 30px auto;
      width: 600px;
      background: #000;
      padding: 15px;
      border-radius: 6px;
    }
  </style>
<%- include('partials/workspace-ui') %>
</head>
<body>

<h1>🚀 PYC Transition Tool</h1>

<p>Nhập danh sách PYC (vd: 14565, 13333)</p>
<textarea id="pycList"></textarea><br>

<button onclick="start()">Start</button>

<pre id="result"></pre>

<script>
async function start() {
  const pycList = document.getElementById("pycList").value;

  const res = await fetch("/api/pyc-transition", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ pycList })
  });

  const data = await res.json();
  document.getElementById("result").innerText =
    JSON.stringify(data, null, 2);
}
</script>

</body>
</html>
