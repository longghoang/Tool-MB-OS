<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07111f">
  <title>Comment Pending PYC · VNCS</title>
  <style>
    :root{--bg:#050811;--panel:rgba(13,19,32,.86);--line:#263247;--text:#eef3ff;--muted:#8e9bb1;--primary:#6d72ff;--amber:#fbbf24;--danger:#fb7185;--success:#34d399;--shadow:0 30px 80px rgba(0,0,0,.46)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:radial-gradient(circle at 12% 8%,rgba(99,102,241,.2),transparent 27%),radial-gradient(circle at 88% 18%,rgba(45,212,191,.12),transparent 25%),linear-gradient(145deg,#070b15,#03050b 72%);overflow-x:hidden}
    body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.026) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,#000,transparent 82%)}
    button,input{font:inherit}.page{position:relative;width:min(1180px,calc(100% - 36px));margin:auto;padding:34px 0 60px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:38px}.brand,.back{display:flex;align-items:center;gap:12px}.mark{width:46px;height:46px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(145deg,#777cff,#4950e9);box-shadow:0 12px 34px rgba(99,102,241,.32);font-size:21px}.brand strong{display:block;font-size:15px}.brand small{display:block;color:var(--muted);margin-top:3px}.back{color:#c9d3e7;text-decoration:none;padding:10px 14px;border:1px solid var(--line);border-radius:13px;background:rgba(13,19,32,.7);transition:.2s}.back:hover{border-color:#6975a0;transform:translateX(-2px)}
    .hero{display:grid;grid-template-columns:1fr auto;align-items:end;gap:28px;margin-bottom:25px}.eyebrow{color:#9ca3ff;font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:10px}.hero h1{margin:0;font-size:clamp(34px,5vw,58px);letter-spacing:-.055em;line-height:1}.hero p{max-width:720px;color:var(--muted);line-height:1.65;margin:15px 0 0}.secure{align-self:center;padding:10px 14px;border:1px solid rgba(52,211,153,.22);background:rgba(52,211,153,.08);border-radius:999px;color:#a7f3d0;font-size:12px;white-space:nowrap}.secure:before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--success);box-shadow:0 0 12px var(--success);margin-right:8px}
    .workspace{border:1px solid rgba(148,163,184,.18);border-radius:28px;background:linear-gradient(160deg,rgba(15,22,37,.94),rgba(7,11,20,.94));box-shadow:var(--shadow);backdrop-filter:blur(20px);overflow:hidden}.steps{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line)}.step{padding:19px 22px;display:flex;gap:13px;align-items:center;border-right:1px solid var(--line);color:var(--muted)}.step:last-child{border:0}.step-num{width:31px;height:31px;display:grid;place-items:center;border-radius:10px;background:#171f31;color:#aeb8ca;font-weight:800;font-size:12px}.step.active{color:#e8ebff;background:rgba(99,102,241,.07)}.step.active .step-num{background:rgba(99,102,241,.2);color:#adb0ff;border:1px solid rgba(129,140,248,.28)}.step strong{display:block;font-size:13px}.step span{display:block;font-size:11px;color:var(--muted);margin-top:3px}
    .content{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:24px;padding:26px}.column{display:flex;flex-direction:column;gap:18px}.card{border:1px solid var(--line);background:rgba(8,13,23,.72);border-radius:20px;padding:21px}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:17px}.card h2{font-size:15px;margin:0}.card p.hint{font-size:12px;color:var(--muted);line-height:1.55;margin:5px 0 0}.badge{padding:5px 9px;border-radius:999px;border:1px solid rgba(148,163,184,.17);background:rgba(148,163,184,.06);color:#aab4c7;font-size:10px;font-weight:800;letter-spacing:.08em}
    label.label{display:block;font-size:12px;font-weight:750;color:#d6deec;margin-bottom:8px}.lookup-row{display:grid;grid-template-columns:1fr auto;gap:10px}.input{width:100%;height:48px;border:1px solid #303b50;border-radius:13px;background:#080d17;color:var(--text);padding:0 15px;outline:none;transition:.2s}.input:focus{border-color:#777cff;box-shadow:0 0 0 4px rgba(99,102,241,.12)}.btn{min-height:46px;border:0;border-radius:13px;padding:0 18px;cursor:pointer;font-weight:800;color:white;background:linear-gradient(135deg,#7277ff,#4b52e8);box-shadow:0 12px 24px rgba(73,80,232,.2);transition:transform .18s,filter .18s,opacity .18s}.btn:hover:not(:disabled){transform:translateY(-2px);filter:brightness(1.08)}.btn:disabled{opacity:.43;cursor:not-allowed;box-shadow:none}.btn-secondary{background:#131b2a;border:1px solid #334158;box-shadow:none;color:#e0e7f5}.contact{display:none;margin-top:15px;padding:14px;border-radius:14px;border:1px solid rgba(45,212,191,.24);background:rgba(45,212,191,.07)}.contact.show{display:block;animation:rise .25s ease}.contact-name{font-size:13px;font-weight:800;color:#d8fff8}.contact-meta{font-size:12px;color:#83dacc;margin-top:4px;word-break:break-word}
    .reasons{display:grid;gap:10px}.reason{position:relative;display:grid;grid-template-columns:auto 1fr;gap:12px;padding:15px;border:1px solid #2b374b;border-radius:15px;background:#0a101c;cursor:pointer;transition:.2s}.reason:hover{border-color:#53617a;transform:translateY(-1px)}.reason:has(input:checked){border-color:#7479ff;background:rgba(99,102,241,.1);box-shadow:0 0 0 3px rgba(99,102,241,.07)}.reason input{appearance:none;width:18px;height:18px;border:2px solid #57647a;border-radius:50%;margin:2px 0 0;display:grid;place-items:center}.reason input:checked{border-color:#8589ff}.reason input:checked:after{content:"";width:8px;height:8px;border-radius:50%;background:#8589ff}.reason strong{font-size:13px}.reason small{display:block;color:var(--muted);font-size:11px;margin-top:4px;line-height:1.45}.reason.warning:has(input:checked){border-color:#e5aa21;background:rgba(251,191,36,.08)}.reason.warning input:checked{border-color:var(--amber)}.reason.warning input:checked:after{background:var(--amber)}
    .drop{min-height:142px;border:1px dashed #38465e;border-radius:16px;background:#080d17;display:grid;place-items:center;text-align:center;padding:18px;cursor:pointer;position:relative;overflow:hidden;transition:.2s}.drop:hover,.drop.drag{border-color:#7479ff;background:rgba(99,102,241,.06)}.drop input{position:absolute;inset:0;opacity:0;cursor:pointer}.drop-icon{font-size:26px}.drop strong{font-size:13px;display:block;margin-top:7px}.drop small{display:block;color:var(--muted);font-size:11px;margin-top:5px}.file-info{display:none;grid-template-columns:58px 1fr auto;align-items:center;gap:12px;margin-top:12px;padding:10px;border:1px solid var(--line);border-radius:14px;background:#0a101b}.file-info.show{display:grid}.thumb{width:58px;height:48px;object-fit:cover;border-radius:9px;background:#151d2c}.file-name{min-width:0;font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.file-size{color:var(--muted);font-size:11px;margin-top:4px}.remove{width:32px;height:32px;border-radius:9px;border:1px solid #38445a;color:#aeb8ca;background:#111827;cursor:pointer}
    [hidden]{display:none!important}.preview{width:100%;min-height:214px;margin:0;white-space:pre-wrap;word-break:break-word;padding:17px;border:1px solid #2a364a;border-radius:15px;background:#070b13;color:#cdd6e6;font:13px/1.72 ui-monospace,SFMono-Regular,Consolas,monospace}.preview.empty{color:#657187}.preview-editor{display:block;resize:vertical;outline:none;transition:border-color .2s,box-shadow .2s}.preview-editor:focus{border-color:#777cff;box-shadow:0 0 0 4px rgba(99,102,241,.11)}.preview-editor:disabled{cursor:not-allowed;color:#657187}.actions{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:17px}.submit{min-width:205px}.privacy{font-size:11px;color:#6f7c91;line-height:1.5}.message{display:none;margin-top:15px;padding:13px 14px;border-radius:13px;font-size:12px;line-height:1.5}.message.show{display:block;animation:rise .24s ease}.message.error{color:#fecdd3;border:1px solid rgba(251,113,133,.35);background:rgba(251,113,133,.09)}.message.success{color:#bbf7d0;border:1px solid rgba(52,211,153,.32);background:rgba(52,211,153,.09)}.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:white;border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;margin-right:7px}
    @keyframes spin{to{transform:rotate(360deg)}}@keyframes rise{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
    @media(max-width:850px){.content{grid-template-columns:1fr}.hero{grid-template-columns:1fr}.secure{justify-self:start}.steps{grid-template-columns:1fr}.step{border-right:0;border-bottom:1px solid var(--line)}.step:last-child{border-bottom:0}}
    @media(max-width:560px){.page{width:min(100% - 22px,1180px);padding-top:18px}.topbar{align-items:flex-start}.brand small{display:none}.hero h1{font-size:36px}.content{padding:14px}.card{padding:16px}.lookup-row{grid-template-columns:1fr}.actions{align-items:stretch;flex-direction:column}.submit{width:100%}.steps{display:none}}
  </style>
<%- include('partials/workspace-ui') %>
</head>
<body>
  <main class="page">
    <header class="topbar"><div class="brand"><div class="mark">💬</div><div><strong>VNCS Workflow</strong><small>Pending Comment Console</small></div></div><a class="back" href="/home">← Trang chủ</a></header>
    <section class="hero"><div><div class="eyebrow">Jira collaboration</div><h1>Comment Pending PYC</h1><p>Tra cứu đúng đầu mối BDA, tạo nội dung Pending theo mẫu và đính kèm ảnh PoC trực tiếp vào Phiếu Yêu cầu.</p></div><div class="secure">Server-side validation</div></section>
    <section class="workspace">
      <div class="steps"><div class="step active"><div class="step-num">01</div><div><strong>Tra cứu PYC</strong><span>Xác định đầu mối BDA</span></div></div><div class="step"><div class="step-num">02</div><div><strong>Chọn hiện trạng</strong><span>Dựng comment theo mẫu</span></div></div><div class="step"><div class="step-num">03</div><div><strong>Gửi comment</strong><span>Kèm ảnh PoC nếu có</span></div></div></div>
      <div class="content">
        <div class="column">
          <section class="card"><div class="card-head"><div><h2>Phiếu Yêu cầu</h2><p class="hint">Nhập phần số, ví dụ 20784. Tool sẽ kiểm tra lại đầu mối trước khi gửi.</p></div><span class="badge">REQUIRED</span></div><label class="label" for="number">Số PYC</label><div class="lookup-row"><input class="input" id="number" inputmode="numeric" autocomplete="off" maxlength="12" placeholder="Ví dụ: 20784"><button class="btn btn-secondary" id="lookup" type="button">Tra cứu</button></div><div class="contact" id="contact"><div class="contact-name" id="contactName"></div><div class="contact-meta" id="contactMeta"></div></div><div class="message" id="lookupMessage"></div></section>
          <section class="card"><div class="card-head"><div><h2>Hiện trạng Pending</h2><p class="hint">Chọn nội dung phù hợp với tình trạng đang ghi nhận.</p></div><span class="badge">05 OPTIONS</span></div><div class="reasons"><label class="reason"><input type="radio" name="reason" value="bm01"><span><strong>Sai/thiếu scope BM01</strong><small>Scope trong BM01 chưa đúng hoặc chưa đủ với hiện trạng Pentest.</small></span></label><label class="reason warning"><input type="radio" name="reason" value="system"><span><strong>Hệ thống lỗi</strong><small>Hệ thống gặp lỗi và chưa thể tiếp tục Pentest.</small></span></label><label class="reason"><input type="radio" name="reason" value="pyc_name"><span><strong>Tên PYC sai</strong><small>Tên PYC trên Jira chưa đúng với nội dung cần Pentest.</small></span></label><label class="reason"><input type="radio" name="reason" value="old_bm01"><span><strong>Xóa BM01 cũ</strong><small>Trên Jira đang tồn tại hai phiên bản BM01.</small></span></label><label class="reason"><input type="radio" name="reason" value="custom"><span><strong>Custom</strong><small>Dùng mẫu có sẵn và chỉnh sửa nội dung comment trước khi gửi.</small></span></label></div></section>
          <section class="card"><div class="card-head"><div><h2>Ảnh PoC</h2><p class="hint">Không bắt buộc · PNG, JPG, GIF hoặc WEBP · tối đa 10 MB.</p></div><span class="badge">OPTIONAL</span></div><label class="drop" id="drop"><input id="image" type="file" accept="image/png,image/jpeg,image/gif,image/webp"><span><span class="drop-icon">⬆</span><strong>Tải ảnh bằng cách chọn hoặc kéo thả</strong><small>Ảnh sẽ được gửi cùng comment</small></span></label><div class="file-info" id="fileInfo"><img class="thumb" id="thumb" alt="Xem trước ảnh PoC"><div><div class="file-name" id="fileName"></div><div class="file-size" id="fileSize"></div></div><button class="remove" id="removeImage" type="button" aria-label="Bỏ ảnh">×</button></div></section>
        </div>
        <div class="column"><section class="card"><div class="card-head"><div><h2>Xem trước comment</h2><p class="hint">Ngày và username đầu mối được điền tự động. Chọn Custom để chỉnh sửa.</p></div><span class="badge">LIVE PREVIEW</span></div><pre class="preview empty" id="preview">Tra cứu PYC và chọn hiện trạng để xem nội dung comment.</pre><textarea class="preview preview-editor" id="customComment" maxlength="4000" placeholder="Tra cứu PYC để tạo mẫu comment Custom." disabled hidden></textarea><div class="actions"><div class="privacy">Comment cuối cùng được kiểm tra tại server trước khi gửi lên JC.</div><button class="btn submit" id="submit" type="button" disabled>Gửi comment Pending</button></div><div class="message" id="submitMessage"></div></section></div>
      </div>
    </section>
  </main>
  <script>
    const state={issue:null,image:null,busy:false};
    const number=document.getElementById('number'),lookup=document.getElementById('lookup'),contact=document.getElementById('contact'),contactName=document.getElementById('contactName'),contactMeta=document.getElementById('contactMeta'),lookupMessage=document.getElementById('lookupMessage'),preview=document.getElementById('preview'),customComment=document.getElementById('customComment'),submit=document.getElementById('submit'),submitMessage=document.getElementById('submitMessage'),imageInput=document.getElementById('image'),fileInfo=document.getElementById('fileInfo'),thumb=document.getElementById('thumb'),fileName=document.getElementById('fileName'),fileSize=document.getElementById('fileSize');
    const selectedReason=()=>document.querySelector('input[name="reason"]:checked')?.value||'';
    function currentDate(){const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Bangkok',day:'numeric',month:'numeric',year:'numeric'}).formatToParts(new Date());const get=type=>Number(parts.find(part=>part.type===type)?.value);return `${get('day')}/${get('month')}/${get('year')}`}
    function commentText(reason,username){if(reason==='bm01')return `Ngày ${currentDate()} hiện trạng: Phần scope trong BM01 đang chưa đúng với hiện trạng Pentest nên không thể hoàn thành công việc Pentest.\nAnh/chị [~${username}] sớm bổ sung và thông báo + chuyển trạng thái jira sau khi hoàn thành để đội pentest tiếp tục công việc ạ`;if(reason==='system')return `Ngày ${currentDate()} hiện trạng: Hệ thống đang lỗi nên không thể hoàn thành công việc Pentest.\nAnh/chị [~${username}] sớm sửa lỗi + chuyển trạng thái jira sau khi hoàn thành để đội pentest tiếp tục công việc ạ`;if(reason==='pyc_name')return `Ngày ${currentDate()} hiện trạng: Tên pyc trên Jira đang chưa đúng nên không thể hoàn thành công việc Pentest. Anh/chị [~${username}] sớm bổ sung và thông báo + chuyển trạng thái jira sau khi hoàn thành để đội pentest tiếp tục công việc ạ`;if(reason==='old_bm01')return `Ngày ${currentDate()} hiện trạng: Hiện đang có 2 phiên bản BM01 trên Jira nên không thể hoàn thành công việc Pentest. Anh/chị [~${username}] sớm bổ sung và thông báo + chuyển trạng thái jira sau khi hoàn thành để đội pentest tiếp tục công việc ạ`;if(reason==='custom')return `Ngày ${currentDate()} hiện trạng: [Nhập nội dung cần Pending]. Anh/chị [~${username}] sớm bổ sung và thông báo + chuyển trạng thái jira sau khi hoàn thành để đội pentest tiếp tục công việc ạ`;return ''}
    function message(element,text,type){element.textContent=text||'';element.className=`message${text?' show '+type:''}`}
    function refresh(){const reason=selectedReason(),isCustom=reason==='custom';preview.hidden=isCustom;customComment.hidden=!isCustom;customComment.disabled=!state.issue||state.busy;if(isCustom&&state.issue&&customComment.dataset.issue!==state.issue.number){customComment.value=commentText('custom',state.issue.contact.username);customComment.dataset.issue=state.issue.number}const text=isCustom?customComment.value.trim():(state.issue&&reason?commentText(reason,state.issue.contact.username):'');preview.textContent=text||'Tra cứu PYC và chọn hiện trạng để xem nội dung comment.';preview.classList.toggle('empty',!text);submit.disabled=!state.issue||!reason||text.length<20||state.busy}
    function resetIssue(){state.issue=null;customComment.value='';customComment.dataset.issue='';contact.classList.remove('show');message(lookupMessage,'','');message(submitMessage,'','');refresh()}
    number.addEventListener('input',()=>{number.value=number.value.replace(/\D/g,'').slice(0,12);resetIssue()});number.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();lookup.click()}});document.querySelectorAll('input[name="reason"]').forEach(input=>input.addEventListener('change',refresh));customComment.addEventListener('input',refresh);
    lookup.addEventListener('click',async()=>{const value=number.value.trim();if(!value){message(lookupMessage,'Nhập số Phiếu Yêu cầu trước khi tra cứu.','error');return}state.busy=true;lookup.disabled=true;lookup.innerHTML='<span class="spinner"></span>Đang tra';message(lookupMessage,'','');refresh();try{const response=await fetch('/pending-comment/lookup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({number:value})});const data=await response.json();if(!response.ok)throw new Error(data.error||'Không tra cứu được PYC.');state.issue=data;contactName.textContent=data.contact.name;contactMeta.textContent=`@${data.contact.username} · ${data.contact.email} · ${data.pyc}`;contact.classList.add('show');message(lookupMessage,'Đã xác định đúng đầu mối BDA.','success')}catch(error){resetIssue();message(lookupMessage,error.message,'error')}finally{state.busy=false;lookup.disabled=false;lookup.textContent='Tra cứu';refresh()}});
    function setImage(file){if(!file){state.image=null;imageInput.value='';fileInfo.classList.remove('show');thumb.removeAttribute('src');return}if(file.size>10*1024*1024){message(submitMessage,'Ảnh PoC không được vượt quá 10 MB.','error');return setImage(null)}if(!/^image\/(png|jpe?g|gif|webp)$/i.test(file.type)){message(submitMessage,'Ảnh PoC phải là PNG, JPG, GIF hoặc WEBP.','error');return setImage(null)}state.image=file;fileName.textContent=file.name;fileSize.textContent=`${(file.size/1024/1024).toFixed(2)} MB`;thumb.src=URL.createObjectURL(file);fileInfo.classList.add('show');message(submitMessage,'','')}
    imageInput.addEventListener('change',()=>setImage(imageInput.files[0]));document.getElementById('removeImage').addEventListener('click',()=>setImage(null));const drop=document.getElementById('drop');['dragenter','dragover'].forEach(type=>drop.addEventListener(type,event=>{event.preventDefault();drop.classList.add('drag')}));['dragleave','drop'].forEach(type=>drop.addEventListener(type,event=>{event.preventDefault();drop.classList.remove('drag')}));drop.addEventListener('drop',event=>setImage(event.dataTransfer.files[0]));
    submit.addEventListener('click',async()=>{if(!state.issue||!selectedReason()||state.busy)return;state.busy=true;submit.disabled=true;submit.innerHTML='<span class="spinner"></span>Đang gửi';message(submitMessage,'','');const form=new FormData();form.append('number',state.issue.number);form.append('reason',selectedReason());if(selectedReason()==='custom')form.append('comment',customComment.value);if(state.image)form.append('image',state.image);try{const response=await fetch('/pending-comment/submit',{method:'POST',body:form});const data=await response.json();if(!response.ok)throw new Error(data.error||'Không gửi được comment Pending.');if(selectedReason()==='custom')customComment.value=data.result.comment;else preview.textContent=data.result.comment;message(submitMessage,`Đã gửi comment thành công tới ${data.result.pyc}${data.result.hasImage?' kèm ảnh PoC':''}.`,'success')}catch(error){message(submitMessage,error.message,'error')}finally{state.busy=false;submit.textContent='Gửi comment Pending';refresh()}});
  </script>
</body>
</html>
