<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản trị Workspace · VNCS</title>
<style>
  :root{--bg:#090d16;--surface:#141b29;--line:#303a50;--text:#eef2fa;--muted:#96a4b8;--primary:#6677f2;color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,sans-serif}
  *{box-sizing:border-box}body{margin:0;min-height:100vh;padding:28px 22px 100px;background:radial-gradient(circle at 20% 0,#28335b55,transparent 40%),var(--bg);color:var(--text)}main{max-width:1140px;margin:auto}a{color:inherit;text-decoration:none}.top{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:32px}.back{padding:10px 14px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.15em;color:#9caaff;font-weight:800}h1{font-size:clamp(30px,5vw,46px);letter-spacing:-.055em;margin:8px 0}p{color:var(--muted);line-height:1.6}.sections{display:grid;grid-template-columns:1fr 1.12fr;gap:20px}.panel{border:1px solid var(--line);border-radius:20px;background:var(--surface);padding:22px;box-shadow:0 18px 48px #0003}.panel-head{display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:15px}.panel h2{font-size:19px;margin:0}.panel-head span{font-size:12px;color:var(--muted)}.module-row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:14px 0;border-top:1px solid var(--line)}.module-row strong{display:block}.module-row small{display:block;color:var(--muted);margin-top:4px;overflow-wrap:anywhere}.switch{position:relative;display:block;flex:none;width:49px;height:28px}.switch input{position:absolute;opacity:0}.switch span{position:absolute;inset:0;border-radius:99px;background:#5a6476;cursor:pointer;transition:background .2s}.switch span:after{content:"";position:absolute;width:20px;height:20px;left:4px;top:4px;border-radius:50%;background:white;transition:transform .2s}.switch input:checked+span{background:#5475e9}.switch input:checked+span:after{transform:translateX(21px)}.message{padding:16px 0;border-top:1px solid var(--line)}.message.unread{border-left:3px solid #6d82ff;padding-left:12px}.message-head{display:flex;justify-content:space-between;gap:12px;align-items:start}.message strong{display:block}.meta{font-size:12px;color:var(--muted);margin-top:3px}.message p{white-space:pre-wrap;overflow-wrap:anywhere;color:var(--text);margin:12px 0}.actions{display:flex;gap:8px}button{padding:8px 11px;border:1px solid var(--line);border-radius:9px;background:#212b3f;color:var(--text);font:650 12px Inter,system-ui;cursor:pointer;transition:transform .2s,border-color .2s}button:hover{transform:translateY(-1px);border-color:#7487fc}.delete{color:#ff8fa4}.empty{padding:28px 0;color:var(--muted);text-align:center}.feedback{min-height:22px;color:#79dbab;font-size:13px}@media(max-width:800px){.sections{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
<%- include('partials/workspace-ui') %>
</head><body><main><div class="top"><div><div class="eyebrow">VNCS / Admin workspace</div><h1>Quản trị hệ thống</h1><p>Điều khiển module cho user và quản lý lời nhắn gửi từ Home.</p></div><a class="back" href="/home">← Về Home</a></div>
<div id="feedback" class="feedback" role="status"></div><div class="sections">
  <section class="panel"><div class="panel-head"><h2>Module cho user</h2><span>Bật / tắt tức thời</span></div>
    <% modules.forEach(module => { %><div class="module-row"><div><strong><%= module.label %></strong><small><%= module.path %></small></div><label class="switch"><input type="checkbox" data-module="<%= module.id %>" <%= module.enabled ? 'checked' : '' %> aria-label="Bật <%= module.label %>"><span></span></label></div><% }) %>
  </section>
  <section class="panel"><div class="panel-head"><h2>Nhắn gửi lời yêu thương</h2><span><%= messages.length %> lời nhắn</span></div>
    <div id="messages"><% if (!messages.length) { %><div class="empty">Chưa có lời nhắn nào.</div><% } %>
      <% messages.forEach(message => { %><article class="message <%= message.read ? '' : 'unread' %>" data-id="<%= message.id %>"><div class="message-head"><div><strong><%= message.senderName %></strong><div class="meta">Tài khoản: <%= message.username %> · <%= new Date(message.createdAt).toLocaleString('vi-VN', { timeZone: 'Asia/Bangkok' }) %></div></div><span class="meta"><%= message.read ? 'Đã đọc' : 'Chưa đọc' %></span></div><p><%= message.content %></p><div class="actions"><button class="read" type="button" data-read="<%= message.read ? 'false' : 'true' %>"><%= message.read ? 'Đánh dấu chưa đọc' : 'Đánh dấu đã đọc' %></button><button class="delete" type="button">Xóa</button></div></article><% }) %>
    </div>
  </section>
</div></main>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const feedback = document.getElementById('feedback');
  const status = text => { feedback.textContent = text; };
  document.querySelectorAll('[data-module]').forEach(input => input.addEventListener('change', async () => {
    input.disabled = true;
    try { await workspaceRequest(`/admin/modules/${encodeURIComponent(input.dataset.module)}`, { method:'POST', body:JSON.stringify({enabled:input.checked}) }); status(`${input.checked ? 'Đã bật' : 'Đã tắt'} module ${input.closest('.module-row').querySelector('strong').textContent}.`); }
    catch(error) { input.checked = !input.checked; status(error.message); }
    finally { input.disabled = false; }
  }));
  document.getElementById('messages').addEventListener('click', async event => {
    const button = event.target.closest('button'); if (!button) return;
    const card = button.closest('[data-id]'); const id = encodeURIComponent(card.dataset.id);
    if (button.classList.contains('delete') && !confirm('Xóa lời nhắn này?')) return;
    button.disabled = true;
    try {
      if (button.classList.contains('delete')) { await workspaceRequest(`/admin/messages/${id}`, {method:'DELETE'}); card.remove(); status('Đã xóa lời nhắn.'); }
      else { const read = button.dataset.read === 'true'; await workspaceRequest(`/admin/messages/${id}/read`, {method:'POST',body:JSON.stringify({read})}); card.classList.toggle('unread', !read); card.querySelector('.message-head>span').textContent = read ? 'Đã đọc' : 'Chưa đọc'; button.dataset.read = String(!read); button.textContent = read ? 'Đánh dấu chưa đọc' : 'Đánh dấu đã đọc'; status('Đã cập nhật lời nhắn.'); }
    } catch(error) { status(error.message); } finally { button.disabled = false; }
  });
});
</script></body></html>
