<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07101f">
  <title>VNCS Workspace · MB OS</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #060b14;
      --surface: rgba(13, 22, 38, .78);
      --surface-strong: #101b2d;
      --line: rgba(148, 163, 184, .15);
      --line-strong: rgba(148, 163, 184, .28);
      --text: #f3f7fc;
      --muted: #91a0b5;
      --blue: #5b8cff;
      --cyan: #28d7d0;
      --green: #41d98a;
      --violet: #aa82ff;
      --amber: #f6b84a;
      --rose: #ff718c;
      --mx: 50vw;
      --my: 20vh;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--text);
      background:
        radial-gradient(700px circle at var(--mx) var(--my), rgba(91, 140, 255, .11), transparent 48%),
        radial-gradient(600px circle at 88% 5%, rgba(40, 215, 208, .08), transparent 46%),
        linear-gradient(145deg, #08101e 0%, var(--bg) 52%, #080d18 100%);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      opacity: .38;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,.023) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.023) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: linear-gradient(to bottom, #000 0%, transparent 82%);
    }

    a { color: inherit; }
    svg { display: block; }

    .orb {
      position: fixed;
      z-index: -1;
      width: 430px;
      aspect-ratio: 1;
      border-radius: 50%;
      filter: blur(85px);
      opacity: .14;
      pointer-events: none;
      animation: drift 16s ease-in-out infinite alternate;
    }
    .orb.one { top: 14%; left: -220px; background: var(--blue); }
    .orb.two { right: -210px; bottom: -100px; background: var(--violet); animation-delay: -7s; }

    .page {
      width: min(1180px, calc(100% - 40px));
      margin: 0 auto;
      padding: 26px 0 38px;
    }

    .topbar {
      position: sticky;
      top: 16px;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      min-height: 66px;
      padding: 11px 14px 11px 12px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(7, 14, 26, .72);
      box-shadow: 0 16px 50px rgba(0, 0, 0, .22);
      backdrop-filter: blur(18px) saturate(130%);
      animation: slideDown .65s cubic-bezier(.2,.8,.2,1) both;
    }

    .brand { display: flex; align-items: center; gap: 12px; }
    .brand-mark {
      position: relative;
      width: 43px;
      height: 43px;
      display: grid;
      place-items: center;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.13);
      border-radius: 13px;
      background: linear-gradient(145deg, rgba(91,140,255,.28), rgba(40,215,208,.13));
      box-shadow: inset 0 1px rgba(255,255,255,.09), 0 10px 28px rgba(27,86,214,.16);
    }
    .brand-mark::after {
      content: "";
      position: absolute;
      width: 55px;
      height: 12px;
      background: rgba(255,255,255,.18);
      transform: rotate(-38deg) translateY(-24px);
      animation: logoShine 5s ease-in-out infinite;
    }
    .brand-mark svg { width: 23px; color: #dbe8ff; }
    .brand-copy strong { display: block; font-size: 14px; letter-spacing: .05em; }
    .brand-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; letter-spacing: .03em; }

    .system-state {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 12px;
      border: 1px solid rgba(65,217,138,.18);
      border-radius: 999px;
      color: #baf5d5;
      background: rgba(65,217,138,.07);
      font-size: 12px;
      font-weight: 650;
    }
    .system-state i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 5px rgba(65,217,138,.09), 0 0 18px rgba(65,217,138,.8);
      animation: breathe 2.2s ease-in-out infinite;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(260px, .55fr);
      gap: 28px;
      align-items: end;
      padding: 86px 8px 48px;
    }
    .hero-copy { animation: rise .75s .08s cubic-bezier(.2,.8,.2,1) both; }
    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 21px;
      color: #9fc1ff;
      font-size: 12px;
      font-weight: 750;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .kicker::before { content: ""; width: 26px; height: 1px; background: currentColor; box-shadow: 0 0 10px currentColor; }
    h1 {
      max-width: 800px;
      margin: 0;
      font-size: clamp(46px, 6.3vw, 80px);
      line-height: .99;
      letter-spacing: -.062em;
      text-wrap: balance;
    }
    h1 span {
      color: transparent;
      background: linear-gradient(110deg, #88aaff 6%, #6fe5df 46%, #d7c6ff 92%);
      background-size: 180% auto;
      -webkit-background-clip: text;
      background-clip: text;
      animation: gradientFlow 8s ease-in-out infinite alternate;
    }
    .hero-copy p {
      max-width: 660px;
      margin: 24px 0 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.75;
    }

    .hero-panel {
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: linear-gradient(145deg, rgba(18,31,51,.75), rgba(10,18,31,.68));
      box-shadow: inset 0 1px rgba(255,255,255,.04);
      animation: rise .75s .19s cubic-bezier(.2,.8,.2,1) both;
    }
    .hero-panel-label { margin-bottom: 15px; color: var(--muted); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
    .metric { display: flex; align-items: end; justify-content: space-between; gap: 16px; }
    .metric strong { font-size: 38px; line-height: 1; letter-spacing: -.05em; }
    .metric span { color: #b9c5d6; font-size: 12px; }
    .signal { display: flex; align-items: end; gap: 4px; height: 32px; }
    .signal i { width: 4px; border-radius: 99px; background: linear-gradient(to top, var(--blue), var(--cyan)); animation: signal 1.35s ease-in-out infinite alternate; }
    .signal i:nth-child(1) { height: 28%; animation-delay: -.4s; }
    .signal i:nth-child(2) { height: 50%; animation-delay: -.8s; }
    .signal i:nth-child(3) { height: 82%; animation-delay: -.2s; }
    .signal i:nth-child(4) { height: 62%; animation-delay: -.65s; }
    .signal i:nth-child(5) { height: 100%; animation-delay: -.95s; }
    .panel-rule { height: 1px; margin: 18px 0 14px; background: linear-gradient(90deg, var(--line-strong), transparent); }
    .panel-note { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 12px; }
    .panel-note svg { width: 16px; color: var(--green); }

    .workspace {
      position: relative;
      padding: 23px;
      border: 1px solid var(--line);
      border-radius: 27px;
      background: linear-gradient(150deg, rgba(15,26,44,.88), rgba(8,14,25,.72));
      box-shadow: 0 34px 100px rgba(0,0,0,.3), inset 0 1px rgba(255,255,255,.04);
      backdrop-filter: blur(14px);
    }
    .workspace-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
      padding: 2px 2px 18px;
      border-bottom: 1px solid var(--line);
    }
    .workspace-head small { display: block; margin-bottom: 7px; color: #7690b4; font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
    .workspace-head h2 { margin: 0; font-size: 22px; letter-spacing: -.025em; }
    .workspace-count { color: var(--muted); font: 12px/1.2 "SFMono-Regular", Consolas, monospace; }

    .tool-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .tool-card {
      --accent: var(--blue);
      position: relative;
      min-height: 232px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      padding: 19px;
      border: 1px solid var(--line);
      border-radius: 19px;
      color: var(--text);
      background: linear-gradient(155deg, rgba(22,36,59,.74), rgba(10,18,31,.83));
      box-shadow: inset 0 1px rgba(255,255,255,.035);
      text-decoration: none;
      transform: translateY(22px);
      opacity: 0;
      transition: transform .35s cubic-bezier(.2,.8,.2,1), border-color .3s ease, box-shadow .3s ease, background .3s ease;
    }
    .tool-card.visible { transform: translateY(0); opacity: 1; transition-delay: var(--delay, 0ms); }
    .tool-card::before {
      content: "";
      position: absolute;
      top: -100px;
      right: -90px;
      width: 210px;
      height: 210px;
      border-radius: 50%;
      background: var(--accent);
      filter: blur(66px);
      opacity: .09;
      transition: opacity .3s ease, transform .4s ease;
    }
    .tool-card::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(320px circle at var(--card-x, 50%) var(--card-y, 0%), color-mix(in srgb, var(--accent) 15%, transparent), transparent 55%);
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s ease;
    }
    .tool-card:hover {
      transform: translateY(-7px);
      border-color: color-mix(in srgb, var(--accent) 45%, transparent);
      background: linear-gradient(155deg, rgba(26,43,70,.9), rgba(10,18,31,.9));
      box-shadow: 0 24px 55px rgba(0,0,0,.28), 0 0 30px color-mix(in srgb, var(--accent) 9%, transparent);
    }
    .tool-card:hover::before { opacity: .16; transform: scale(1.12); }
    .tool-card:hover::after { opacity: 1; }
    .tool-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
    .tool-card > * { position: relative; z-index: 1; }

    .tool-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .tool-icon {
      width: 45px;
      height: 45px;
      display: grid;
      place-items: center;
      border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
      border-radius: 13px;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 9%, transparent);
      box-shadow: inset 0 1px rgba(255,255,255,.05);
    }
    .tool-icon svg { width: 22px; height: 22px; }
    .tool-arrow {
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 50%;
      color: #75859c;
      transition: transform .3s ease, color .3s ease, border-color .3s ease;
    }
    .tool-arrow svg { width: 14px; }
    .tool-card:hover .tool-arrow { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); transform: translate(2px,-2px); }
    .tool-card h3 { margin: 25px 0 8px; font-size: 17px; letter-spacing: -.018em; }
    .tool-card p { margin: 0; color: var(--muted); font-size: 12.5px; line-height: 1.6; }
    .tool-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 20px; padding-top: 13px; border-top: 1px solid var(--line); }
    .tool-tag { color: color-mix(in srgb, var(--accent) 78%, white); font: 700 9px/1 "SFMono-Regular", Consolas, monospace; letter-spacing: .11em; text-transform: uppercase; }
    .tool-open { color: #617189; font: 10px/1 "SFMono-Regular", Consolas, monospace; }
    .accent-cyan { --accent: var(--cyan); }
    .accent-green { --accent: var(--green); }
    .accent-violet { --accent: var(--violet); }
    .accent-amber { --accent: var(--amber); }
    .accent-rose { --accent: var(--rose); }

    .footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 24px 5px 0;
      color: #607087;
      font-size: 11px;
      letter-spacing: .04em;
    }
    .footer strong { color: #8796aa; font-weight: 600; }

    @keyframes slideDown { from { opacity: 0; transform: translateY(-14px); } }
    @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
    @keyframes breathe { 50% { opacity: .5; transform: scale(.78); } }
    @keyframes signal { to { height: 25%; opacity: .55; } }
    @keyframes drift { to { transform: translate(90px,-45px) scale(1.08); } }
    @keyframes gradientFlow { to { background-position: 100% 50%; } }
    @keyframes logoShine { 0%,68% { transform: rotate(-38deg) translateY(-38px); } 84%,100% { transform: rotate(-38deg) translateY(38px); } }

    @media (max-width: 1020px) { .tool-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
    @media (max-width: 760px) {
      .page { width: min(100% - 24px, 1180px); padding-top: 12px; }
      .topbar { top: 10px; border-radius: 15px; }
      .brand-copy span { display: none; }
      .hero { grid-template-columns: 1fr; padding: 62px 4px 34px; }
      .hero-panel { max-width: 360px; }
      .workspace { padding: 15px; border-radius: 21px; }
      .workspace-head { align-items: flex-start; flex-direction: column; gap: 9px; }
    }
    @media (max-width: 560px) {
      .tool-grid { grid-template-columns: 1fr; }
      .tool-card { min-height: 205px; }
      .system-state span { display: none; }
      .system-state { width: 35px; height: 35px; justify-content: center; padding: 0; }
      h1 { font-size: clamp(42px, 14vw, 60px); }
      .footer { align-items: flex-start; flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
      .tool-card { opacity: 1; transform: none; }
      .tool-card:hover { transform: none; }
    }
  </style>
<%- include('partials/workspace-ui') %>
</head>
<body>
  <div class="orb one"></div><div class="orb two"></div>
  <main class="page">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4.5 6.5v5c0 4.7 3.2 8 7.5 9.5 4.3-1.5 7.5-4.8 7.5-9.5v-5L12 3Z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <div class="brand-copy"><strong>VNCS · MB OS</strong><span>Security Operations Workspace</span></div>
      </div>
      <div class="system-state"><i></i><span>Workspace online</span></div>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <div class="kicker">Internal security workspace</div>
        <h1>Chào các tướng sĩ, <span>các tướng sĩ zất zả zồi</span></h1>
        <p>Tập trung các công cụ đánh giá, tự động hóa và báo cáo vào một không gian làm việc gọn gàng cho đội ngũ VNCS.</p>
      </div>
      <aside class="hero-panel" aria-label="Trạng thái workspace">
        <div class="hero-panel-label">Available modules</div>
        <div class="metric"><div><strong><%= workspaceUser.role === 'admin' ? workspaceModules.length : workspaceModules.filter(module => module.enabled).length %></strong><br><span>Công cụ sẵn sàng</span></div><div class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></div>
        <div class="panel-rule"></div>
        <div class="panel-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>Hệ thống hoạt động bình thường</div>
      </aside>
    </section>

    <section class="workspace" aria-labelledby="workspace-title">
      <header class="workspace-head">
        <div><small>Tool directory</small><h2 id="workspace-title">Chọn công cụ để bắt đầu</h2></div>
        <div class="workspace-count"><%= workspaceUser.role === 'admin' ? workspaceModules.length : workspaceModules.filter(module => module.enabled).length %> modules · secure access</div>
      </header>

      <div class="tool-grid">
        <% if (workspaceUser.role === 'admin' || workspaceModules.find(module => module.id === 'scope-review').enabled) { %>
        <a class="tool-card" href="/scope-review" style="--delay:0ms">
          <div><div class="tool-top"><div class="tool-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4M8.5 11h5M11 8.5v5"/></svg></div><div class="tool-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg></div></div><h3>BM01 Scope Review</h3><p>Đối soát scope, tài liệu PYC và luồng nghiệp vụ bằng AI.</p></div>
          <div class="tool-foot"><span class="tool-tag">Scope · AI</span><span class="tool-open">01</span></div>
        </a>

        <% } if (workspaceUser.role === 'admin' || workspaceModules.find(module => module.id === 'pending-comment').enabled) { %>
        <a class="tool-card accent-cyan" href="/pending-comment" style="--delay:55ms">
          <div><div class="tool-top"><div class="tool-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h9a4 4 0 0 1 4 4v8Z"/><path d="M8 9h8M8 13h5"/></svg></div><div class="tool-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg></div></div><h3>Comment Pending PYC</h3><p>Tạo comment Pending đúng mẫu và đính kèm ảnh PoC lên phiếu.</p></div>
          <div class="tool-foot"><span class="tool-tag">JIRA · Flow</span><span class="tool-open">02</span></div>
        </a>

        <% } if (workspaceUser.role === 'admin' || workspaceModules.find(module => module.id === 'excel').enabled) { %>
        <a class="tool-card accent-green" href="/excel" style="--delay:110ms">
          <div><div class="tool-top"><div class="tool-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Z"/><path d="M4 9h16M9 9v12M14.5 13.5h2M14.5 17h2"/></svg></div><div class="tool-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg></div></div><h3>BBXN Task Lookup</h3><p>Tra tên công việc từ danh sách Mã JIRA và copy đúng thứ tự vào Excel.</p></div>
          <div class="tool-foot"><span class="tool-tag">Data · Excel</span><span class="tool-open">03</span></div>
        </a>

        <% } if (workspaceUser.role === 'admin' || workspaceModules.find(module => module.id === 'pentest-report').enabled) { %>
        <a class="tool-card accent-violet" href="/pentest-report" style="--delay:165ms">
          <div><div class="tool-top"><div class="tool-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2h8l4 4v16H6V2Z"/><path d="M14 2v5h5M9 12h6M9 16h6"/></svg></div><div class="tool-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg></div></div><h3>Pentest Report</h3><p>Viết finding, chấm CVSS và xuất báo cáo Word/PDF theo template.</p></div>
          <div class="tool-foot"><span class="tool-tag">Report · CVSS</span><span class="tool-open">04</span></div>
        </a>

        <% } if (workspaceUser.role === 'admin' || workspaceModules.find(module => module.id === 'ai-checklist').enabled) { %>
        <a class="tool-card accent-violet" href="/ai-checklist/decision" style="--delay:220ms">
          <div><div class="tool-top"><div class="tool-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v3M5.6 5.6l2.1 2.1M3 12h3M18 12h3M16.3 7.7l2.1-2.1"/><path d="M9 18h6M10 21h4M8 14a5 5 0 1 1 8 0c-1 1-1 2-1 2H9s0-1-1-2Z"/></svg></div><div class="tool-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg></div></div><h3>AI Pentest Checklist</h3><p>Tạo checklist kiểm thử dựa trên ngữ cảnh, scope và loại mục tiêu.</p></div>
          <div class="tool-foot"><span class="tool-tag">AI · Checklist</span><span class="tool-open">05</span></div>
        </a>

        <% } if (workspaceUser.role === 'admin' || workspaceModules.find(module => module.id === 'pyc-transition').enabled) { %>
        <a class="tool-card accent-amber" href="/home/pyc-transition" style="--delay:275ms">
          <div><div class="tool-top"><div class="tool-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 3h4v4M21 3l-6 6M7 21H3v-4M3 21l6-6M14 5H9a4 4 0 0 0-4 4v2M10 19h5a4 4 0 0 0 4-4v-2"/></svg></div><div class="tool-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg></div></div><h3>PYC Transition</h3><p>Quản lý chuyển đổi, mapping và trạng thái xử lý của danh sách PYC.</p></div>
          <div class="tool-foot"><span class="tool-tag">Workflow</span><span class="tool-open">06</span></div>
        </a>

        <% } if (workspaceUser.role === 'admin' || workspaceModules.find(module => module.id === 'manday').enabled) { %>
        <a class="tool-card accent-rose" href="/manday" style="--delay:330ms">
          <div><div class="tool-top"><div class="tool-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18M8 14h2M14 14h2M8 17h2"/></svg></div><div class="tool-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg></div></div><h3>Manday Manager</h3><p>Theo dõi effort, workload và phân bổ nguồn lực cho từng công việc.</p></div>
          <div class="tool-foot"><span class="tool-tag">Resource</span><span class="tool-open">07</span></div>
        </a>

        <% } if (workspaceUser.role === 'admin' || workspaceModules.find(module => module.id === 'aes').enabled) { %>
        <a class="tool-card accent-cyan" href="/aes" style="--delay:385ms">
          <div><div class="tool-top"><div class="tool-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg></div><div class="tool-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg></div></div><h3>MO Crypto Tool</h3><p>Mã hóa và giải mã AES CBC cho API encrypted body và reverse workflow.</p></div>
          <div class="tool-foot"><span class="tool-tag">Crypto · AES</span><span class="tool-open">08</span></div>
        </a>
        <% } %>
      </div>
    </section>

    <footer class="footer"><span>MB OS · Internal Security Toolkit</span><span>Built for <strong>VNCS Secure Operations</strong></span></footer>
  </main>

  <script>
    const root = document.documentElement;
    let frame;
    window.addEventListener("pointermove", event => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        root.style.setProperty("--mx", `${event.clientX}px`);
        root.style.setProperty("--my", `${event.clientY}px`);
        frame = null;
      });
    }, { passive: true });

    const cards = document.querySelectorAll(".tool-card");
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: .12 });
    cards.forEach(card => {
      observer.observe(card);
      card.addEventListener("pointermove", event => {
        const box = card.getBoundingClientRect();
        card.style.setProperty("--card-x", `${event.clientX - box.left}px`);
        card.style.setProperty("--card-y", `${event.clientY - box.top}px`);
      }, { passive: true });
    });
  </script>
</body>
</html>
